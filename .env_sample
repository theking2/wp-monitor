NETWORK_NAME=wp-mon
PROJECT_NAME=wp-mon

# IMAP mailbox to monitor
# port 993 = implicit TLS (encryption=ssl, the default) — most providers.
# port 143 = STARTTLS (encryption=tls) or plaintext (encryption=, not recommended).
# Never 465 — that's the SMTPS port, not IMAP.
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# outgoing mail (forwarding + tamper reports)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FORWARD_TO_EMAIL=
REPORT_TO_EMAIL=

# auth
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# sqlite
DB_PATH=/var/www/html/database/wp-monitor.sqlite

# logging (monolog + kingsoft/monolog-handler, cron-based rotation)
# LOG_PATH default resolves to a `logs/` folder one level above htdocs (matches
# the docker-compose ./logs mount and the Plesk vhost-root/logs convention).
LOG_PATH=
LOG_LEVEL=info
LOG_ROTATE_CRON=0 0 * * *
LOG_ROTATE_MAX_FILES=14
LOG_ROTATE_MIN_SIZE=0
LOG_ROTATE_COMPRESS=false
