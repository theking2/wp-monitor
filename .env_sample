NETWORK_NAME=wp-mon
PROJECT_NAME=wp-mon

# IMAP mailbox to monitor
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# outgoing mail (forwarding + tamper reports)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FORWARD_TO_EMAIL=
REPORT_TO_EMAIL=

# auth
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# sqlite
DB_PATH=/var/www/html/database/wp-monitor.sqlite
