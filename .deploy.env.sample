# Copy to .deploy.env and fill in — .deploy.env is gitignored, this sample is not.
# Used by deploy-frontend.sh to upload the built SPA (htdocs/assets/app) via lftp.

# ftp | ftps | sftp — ftps works on virtually every Plesk plan; use sftp if you have SSH access
# and prefer key-based auth over a password.
DEPLOY_PROTOCOL=ftps

DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=

# Leave blank to use SSH key/agent auth when DEPLOY_PROTOCOL=sftp.
DEPLOY_PASSWORD=

# For sftp key auth, e.g. ~/.ssh/id_ed25519. Optional even for sftp (agent/default key is fine).
DEPLOY_SSH_KEY=

# The directory this uploads to gets its extra files DELETED to match the local build
# (needed since Vite hashes filenames — otherwise old JS/CSS bundles pile up forever).
# Point this at the built-app folder specifically, never at the whole webroot.
DEPLOY_REMOTE_PATH=/httpdocs/assets/app
